# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.
#
# WAŻNE: zawsze bierz hasło w cudzysłów. Node (--env-file) traktuje znak `#`
# jako początek komentarza, więc niecytowane hasło zawierające `#` zostanie
# ucięte w tym miejscu — logowanie SMTP zwróci wtedy "535 Authentication failed",
# mimo że hasło jest poprawne.

SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=website-form@example.com
SMTP_PASS="tutaj-haslo-w-cudzyslowie"
MAIL_TO=karol.konop@gmail.com

# Opcjonalne — domyślnie 3003
PORT=3003

# --- Panel administratora /kierownik (vamude-kit) ---
# Identyfikator klienta OAuth Google (publiczny; Google Cloud -> Credentials -> OAuth client ID -> Web
# application). W "Authorized JavaScript origins" adres strony; sekret klienta i redirect URI niepotrzebne.
GOOGLE_CLIENT_ID=
# Adresy administratorów po przecinku: logowanie /kierownik i statystyki /kierownik/stats.
ADMIN_EMAILS=
# Tylko podgląd na STAGING: wejście do /kierownik bez Google (działa wyłącznie na *.staging.vamude.com).
# PREVIEW_LOGIN=true

# Statystyki odwiedzin (vamude-kit)
# Plik bazy statystyk (domyślnie data/stats.sqlite).
# STATS_DB=
