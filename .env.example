# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.
#
# WAŻNE: zawsze bierz hasło w cudzysłów. Node (--env-file) traktuje znak `#`
# jako początek komentarza, więc niecytowane hasło zawierające `#` zostanie
# ucięte w tym miejscu — logowanie SMTP zwróci wtedy "535 Authentication failed",
# mimo że hasło jest poprawne.

SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=website-form@chrustfolkmusic.pl
SMTP_PASS="tutaj-haslo-w-cudzyslowie"
MAIL_TO=karol.konop@gmail.com

# Opcjonalne — domyślnie 3003
PORT=3003
